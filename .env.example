# To allow lookups using the Merriam-Webster Collegiate Dictionary
# 1) copy this file to .env and fill in a key.
# 2) Run 'heroku config:set DICTIONARY_API_KEY=<your-key> --app richards-board-games'
#
# Keys allowing free use, with some limitations, can be obtained from https://dictionaryapi.com/
DICTIONARY_API_KEY=

# Match archive (Supabase). Schema: docs/archive-schema.sql
# Values are in the Supabase dashboard: Project Settings -> API (Data API and API Keys).
#
# All four values are also needed on Heroku (the VITE_ ones because Heroku runs the Vite build):
#   heroku config:set SUPABASE_URL=<url> SUPABASE_SERVICE_KEY=<secret-key> VITE_SUPABASE_URL=<url> VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key> --app richards-board-games
#
# Server-side (writes). The service key is SECRET - never give it a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
#
# Client-side (read-only; public by design, protected by row level security).
# For the GitHub Pages build, also set these as repository Actions variables
# (Settings -> Secrets and variables -> Actions -> Variables).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
